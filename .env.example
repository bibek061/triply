PORT=4173
HOST=127.0.0.1
# Set to the exact HTTPS origin when deploying behind a TLS reverse proxy.
# PUBLIC_ORIGIN=https://your-triply-domain.example

# Obtain credentials from your own Amadeus developer account.
# Reference: https://github.com/amadeus4dev/amadeus-node
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test returns sandbox data; production requires approved production credentials.
AMADEUS_ENV=test
