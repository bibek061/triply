PORT=4173
HOST=127.0.0.1
# Optional absolute directory on a persistent volume. Default: ./private-data
# DATA_DIR=/var/lib/triply
# Set to the exact HTTPS origin when deploying behind a TLS reverse proxy.
# PUBLIC_ORIGIN=https://your-triply-domain.example
# Production startup requires DATA_DIR and an HTTPS PUBLIC_ORIGIN.
# On Render, its platform-provided RENDER_EXTERNAL_URL is used automatically.
# Set PUBLIC_ORIGIN explicitly when using a custom domain.
# NODE_ENV=production

# Current flight provider: create a Duffel access token in your own dashboard.
# Test/live mode is verified from each API response, not assumed from configuration.
DUFFEL_ACCESS_TOKEN=

# Booking.com Demand API v3.2; approved managed affiliate product access required.
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_ENV=test

# Replace public discovery services with managed/self-hosted services before scale.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional in-page Google search map (Maps Embed API only, no Places API calls).
# Public browser key: restrict to Maps Embed API and your website HTTP referrers.
# Google requires your own Cloud project and billing account; Embed usage is free.
GOOGLE_MAPS_EMBED_API_KEY=
